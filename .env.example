DATABASE_URL="postgresql://user:password@localhost:5432/hyreli" # PostgreSQL connection string
DISCORD_CLIENT_ID="" # Discord client ID for OAuth2 authentication
DISCORD_CLIENT_SECRET="" # Discord client secret for OAuth2 authentication
AUTH_SECRET="" # Secret key for authentication and session management, run openssl rand -base64 32
AUTH_URL="" # Required on Vercel, e.g. https://your-app.vercel.app
OWNER_DISCORD_ID="" # Your Hyreli instance owner Discord ID

# SMTP Configuration (optional - for email notifications)
SMTP_HOST="" # e.g. smtp.zoho.com
SMTP_PORT="465" # 465 for SSL, 587 for TLS
SMTP_USER="" # Your Zoho email address
SMTP_PASS="" # Your Zoho email password or app password
SMTP_FROM_NAME="Hyreli" # Name shown in email sender
SMTP_FROM_EMAIL="" # Email address shown in sender field
